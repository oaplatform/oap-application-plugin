{
    generate = [ token-accessors="yes" ]

    parserClass="oap.application.plugin.gen.parser.OapParser"
    parserUtilClass="oap.application.plugin.parser.OapParserUtil"

    implements="oap.application.plugin.psi.OapCompositeElement"
    extends="oap.application.plugin.psi.impl.OapCompositeElementImpl"

    elementTypeHolderClass="oap.application.plugin.gen.OapTypes"
    elementTypePrefix="OAP_"
    elementTypeClass="oap.application.plugin.psi.OapCompositeElementType"
    tokenTypeClass="oap.application.plugin.psi.OapTokenType"

    psiClassPrefix="Oap"
    psiImplClassSuffix="Impl"
    psiPackage="oap.application.plugin.gen.psi"
    psiImplPackage="oap.application.plugin.gen.psi.impl"

    psiImplUtilClass="oap.application.plugin.psi.impl.GrammarPsiImplUtil"


    tokens = [
        eq="="
        leftbrace="{"
        rightbrace="}"
        leftbracket="["
        rightbracket="]"
        leftparen="("
        rightparen=")"
        leftangle='<'
        rightangle='>'
        comma=','
        colon=':'
        dollar='$'

        indent='indent'
        dedent='dedent'

        duration='regexp:[0-9]+(kb|mb|gb|ms|s|m|h|d|w)'

        dot='.'
        dash='-'

        bool='regexp:true|false'

        id_modules='modules'
        id_serives='services'
        id_kernel='kernel'
        id_this='this'
        id_self='self'

        id_enabled='enabled'
        id_abstract='abstract'
        id_default='default'
        id_name='name'
        id_depends_on='dependsOn'
        id_include='include'
        id_required='required'
        id_services='services'
        id_parameters='parameters'
        id_implementation='implementation'
        id_remote='remote'
        id_url='url'
        id_timeout='timeout'
        id_configurations='configurations'
        id_loader='loader'
        id_config='config'
        id_listen='listen'
        id_link='link'
        id_sessionaware='sessionAware'
        id_interceptors='interceptors'
        id_path='path'
        id_port='port'
        id_blocking='blocking'
        id_compression='compression'
        id_ws_service='ws-service'
        id_ws_handler='ws-handler'
        id_supervision='supervision'
        id_supervise='supervise'
        id_schedule='schedule'
        id_thread='thread'
        id_delay='delay'
        id_cron='cron'
        id_kernel='kernel'

        key_name="regexp:\w+"
        key_value="regexp:\w+"

        block_scalar='regexp:[|>][-+]?[^\x00]*'

        nextline='regexp:\r\n|\n'
        string='regexp:"(\\"|[^"])*"'
        comment='regexp:(//|#)[^\n]+'
    ]
}

module ::=
        []
        module_name_pair
        ( &'enabled' module_enabled )?
        ( &'dependsOn' module_depends_on )?
        ( &'include' module_include )*
        ( &'services' module_services )?
        ( &'configurations' module_configurations )? {
    pin = 1
    recoverWhile=recover_module
}


class_name_psi ::= class_name {
    mixin="oap.application.plugin.psi.OapClassValueMixin"
}

env_value ::=  '$' '{' key_value '}'
id_value ::=  env_value id_value? | key_value id_value?
function ::= &(id_value '(') id_value '(' id_value ')' {
    pin = 2
}

bool_value ::= bool {
    methods=[getBooleanValue]
    implements="oap.application.plugin.psi.OapValue"
}

any_reference_in ::= &'modules' reference_modules_value_in | &'services' reference_services_in | &'kernel' reference_kernel_value_in
any_reference ::= '<'  any_reference_in '>' {
    pin=1
    recoverWhile=recover_reference
}
reference_type_kernel ::= [] 'kernel'  { pin=1 }
reference_kernel_value_in ::= reference_type_kernel '.' 'self' { pin=1 }
reference_kernel_value ::= '<' reference_kernel_value_in '>' {
    pin=1
    implements="oap.application.plugin.psi.OapValue"
}
reference_type_modules ::= [] 'modules' { pin=1 }
reference_modules_name ::= [] (reference_value | 'this') {
    pin=1
    methods=[getReferences]
    implements="oap.application.plugin.psi.IModuleName"
}
reference_modules_service_name ::= [] reference_value {
    pin=1
    implements="oap.application.plugin.psi.IServiceName"
    methods=[getReference]
}
reference_modules_value_in ::= reference_type_modules '.' reference_modules_name '.' reference_modules_service_name { pin=1 }
reference_modules_value ::= '<' reference_modules_value_in '>' {
    pin=1
    methods=[getReferenceModuleName getReferenceServiceName]
    implements="oap.application.plugin.psi.OapValue"
}
reference_type_services ::= [] 'services'  { pin=1 }
reference_type_services_self ::= [] 'self' { pin=1 }
reference_type_services_property ::= [] reference_value { pin=1 }
reference_services_in ::= reference_type_services '.' reference_type_services_self '.' reference_type_services_property {pin=1}
reference_services_value ::= '<' reference_services_in '>' {
    pin=1
    implements="oap.application.plugin.psi.OapValue"
}

module_name ::= [] (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.IModuleName"
}
module_name_pair ::= [] id_name (eq | colon) module_name {
    pin=1
    extends="oap.application.plugin.psi.impl.OapModuleNameBaseImpl"
    implements="oap.application.plugin.psi.OapKeyValuePair"
    stubClass="oap.application.plugin.stub.OapModuleNameStub"
    elementTypeFactory="oap.application.plugin.psi.impl.OapElementTypeFactory.factory"
}

// enabled =
module_enabled ::= 'enabled' ('=' | ':') bool {
    pin=1
    recoverWhile=recover_module
}
// enabled =

// dependsOn = [
module_depends_on_name ::= key_value {
    implements=["oap.application.plugin.psi.IndentNormal";"oap.application.plugin.psi.IModuleName"]
    methods=[getReferences]
}
module_depends_on ::= 'dependsOn' ('=' | ':') (module_depends_on_block | '[' ((module_depends_on_name|block_scalar_value) (','? (module_depends_on_name|block_scalar_value) )* )? ']' | module_depends_on_name | block_scalar_value) {
    pin=1
    recoverWhile=recover_module
}
private module_depends_on_block ::= indent module_depends_on_block_item+ dedent { pin=1 }
private module_depends_on_block_item ::= '-' (module_depends_on_name | block_scalar_value) { pin=1 }
// ] // dependsOn

// services {
module_services ::= 'services' ( module_services_brace | module_services_colon ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePair"
    methods=[getServices]
}
private module_services_brace ::= '{' module_services_service* '}' { pin=1 }
private module_services_colon ::= ':' indent module_services_service* dedent { pin=1 }
service_name ::= key_name
module_services_service ::= service_name ( &'.' dot_implementation_service | object_service ) {
    pin=1
    implements=["com.intellij.psi.PsiNamedElement"]
    mixin="oap.application.plugin.psi.impl.OapModuleServicesServiceImpl"
    elementTypeFactory="oap.application.plugin.psi.impl.OapElementTypeFactory.factory"
    stubClass="oap.application.plugin.stub.OapModuleServicesServiceStub"
}

private dot_implementation_service ::= '.' module_services_service_implementation {
    pin=1
}
private object_service ::= object_service_brace | object_service_colon
private object_service_brace ::= '{' module_services_service_entities '}' { pin=1 }
private object_service_colon ::= ':' indent module_services_service_entities dedent { pin=1 }

private module_services_service_entities ::=
    ( &'enabled' module_services_service_enabled )?
    ( &'abstract' module_services_service_abstract )?
    module_services_service_implementation
    ( &'dependsOn' module_services_service_dependson )?
    ( &'default' module_services_service_default )?
    ( &'listen' module_services_service_listen )?
    ( &'parameters' module_services_service_parameters )?
    ( &'link' module_services_service_link )?
    ( &'remote' module_services_service_remote)?
    ( &'ws-service' module_services_service_wsservice)?
    ( &'ws-handler' module_services_service_wshandler)?
    ( &'supervision' module_services_service_supervision )?


module_services_service_enabled ::= 'enabled' ('=' | ':') bool_value {
    pin=1
    mixin = "oap.application.plugin.psi.OapModuleServicesServiceEnabledMixin"
}




// dependsOn = [
module_services_service_dependson_name ::= key_value {
    implements=["oap.application.plugin.psi.IndentNormal";"oap.application.plugin.psi.IServiceName"]
    methods=[getReference]
}
module_services_service_dependson_id ::= 'dependsOn'
module_services_service_dependson ::= module_services_service_dependson_id ('=' | ':') (module_services_service_dependson_block | '[' (module_services_service_dependson_name|block_scalar_value)? ( ','? (module_services_service_dependson_name|block_scalar_value) )* ']' | module_services_service_dependson_name | block_scalar_value)* {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
private module_services_service_dependson_block ::= indent module_services_service_dependson_block_item+ dedent { pin=1 }
private module_services_service_dependson_block_item ::= '-' (module_services_service_dependson_name | block_scalar_value) { pin=1 }
// ] // dependsOn

module_services_service_abstract ::= 'abstract' ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_services_service_implementation ::= 'implementation' ('=' | ':') class_name_psi {
    pin=1
    extends="oap.application.plugin.psi.impl.OapModuleServicesServiceImplementationImpl"
}

module_services_service_default ::= 'default' ('=' | ':') reference_modules_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
// } // services


// parameters {
module_services_service_parameters_id ::= 'parameters'
module_services_service_parameters ::= module_services_service_parameters_id ( &'.' dot_parameters | java_parameters_object )  {
    pin=1
    mixin="oap.application.plugin.psi.OapModuleServicesServiceParametersMixin"
}
private dot_parameters ::= '.' java_parameter_key_value
private parameters_object_entries ::= parameter_key_value? (','? parameter_key_value )*
parameters_object ::= parameters_object_brace | parameters_object_colon
private parameters_object_brace ::= '{' parameters_object_entries '}' { pin=1 }
private parameters_object_colon ::= ':' indent parameters_object_entries dedent { pin=1 }
block_scalar_value ::= block_scalar {
    implements="oap.application.plugin.psi.OapValue"
    methods=[getScalarText]
}

parameters_array ::= '[' parameters_array_item? (','? parameters_array_item)* ']' {pin=1}
parameters_array_item ::= &'<' any_reference | &'{' parameters_object | function | bool_value | block_scalar_value | id_value {
    implements="oap.application.plugin.psi.IndentNormal"
}

java_parameter_key_value ::= parameter_key_value
private java_parameters_object_entries ::= java_parameter_key_value? (','? java_parameter_key_value )*
private java_parameters_object ::= java_parameters_object_brace | java_parameters_object_colon
private java_parameters_object_brace ::= '{' java_parameters_object_entries '}' { pin=1 }
private java_parameters_object_colon ::= ':' indent java_parameters_object_entries dedent { pin=1 }

parameter_key_value_first_id ::= key_name {
    methods=[getReference]
}
parameter_key_value ::= parameter_key_value_first_id ('.' key_name)*
    (&'=' parameter_key_value_key_eq
     | &'{' parameter_key_value_key_object
     | &(':' indent '-') parameter_key_value_array_block
     | &(':' indent) parameter_key_value_key_object
     | parameter_key_value_key_colon) {
    pin=1
    mixin="oap.application.plugin.psi.OapModuleServicesServiceParameterKeyValueMixin"
}
private parameter_key_value_array_block ::= ':' indent parameter_key_value_array_block_item+ dedent { pin=1 }
private parameter_key_value_array_block_item ::= '-' parameters_array_item { pin=1 }
private parameter_key_value_value ::= &'[' parameters_array | &'<' any_reference | function | bool_value | block_scalar_value | id_value
private parameter_key_value_key_eq ::= '=' parameter_key_value_value { pin=1 }
private parameter_key_value_key_colon ::= ':' parameter_key_value_value { pin=1 }
private parameter_key_value_key_object ::= parameters_object
// } parameters


// listen|link {
module_services_service_listen ::= 'listen' ( &'.' dot_module_services_service_link_field | module_services_service_link_field_object) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

dot_module_services_service_link_field ::= '.' module_services_service_link_field {pin=1}
module_services_service_link_field_object ::= module_services_service_link_field_object_brace | module_services_service_link_field_object_colon
private module_services_service_link_field_object_brace ::= '{' module_services_service_link_field* '}' { pin=1 }
private module_services_service_link_field_object_colon ::= ':' indent module_services_service_link_field* dedent { pin=1 }

module_services_service_link_field ::= key_name ('=' | ':') reference_modules_value {
    pin=1
    implements="oap.application.plugin.psi.IndentNormal"
}

module_services_service_link ::= 'link' ( &'.' dot_module_services_service_link_field | module_services_service_link_field_object ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
// } // listen|link



// supervision {
module_services_service_supervision ::= 'supervision' ( &'.' dot_supervision | supervision_object ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

private dot_supervision ::= '.' module_services_service_supervision_entities {pin=1}
private supervision_object ::= supervision_object_brace | supervision_object_colon
private supervision_object_brace ::= '{' module_services_service_supervision_entities* '}' { pin=1 }
private supervision_object_colon ::= ':' indent module_services_service_supervision_entities* dedent { pin=1 }

private module_services_service_supervision_entities ::=
      &'supervise' module_services_service_supervision_entities_supervise
    | &'schedule' module_services_service_supervision_entities_schedule
    | &'thread' module_services_service_supervision_entities_thread
    | &'delay' module_services_service_supervision_entities_delay
    | &'cron' module_services_service_supervision_entities_cron

module_services_service_supervision_entities_supervise ::= 'supervise' (eq | colon) bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_services_service_supervision_entities_schedule ::= 'schedule' ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_services_service_supervision_entities_thread ::= 'thread' ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_services_service_supervision_entities_delay ::= 'delay' ('=' | ':') (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_services_service_supervision_entities_cron ::= 'cron' ('=' | ':') (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
// } supervision


// remote {
module_services_service_remote ::= 'remote' (&'.' dot_remote | remote_object ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
dot_remote ::= '.' remote_name {pin=1}
remote_object ::= remote_object_brace | remote_object_colon
private remote_object_brace ::= '{' remote_entries '}' { pin=1 }
private remote_object_colon ::= ':' indent remote_entries dedent { pin=1 }
remote_entries ::= (&'name' remote_name | &'timeout' remote_timeout | &'url' remote_url )*

remote_name ::= 'name' ('=' | ':') reference_modules_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
    recoverWhile=recover_remote
}

remote_url ::= 'url' ('=' | ':') (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

remote_timeout_id_value ::= 'timeout'
remote_timeout ::= remote_timeout_id_value (eq | colon) (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
    recoverWhile=recover_to_end_of_line
}

private recover_remote ::= !('name' | 'url' | '}' | 'timeout' | '>' | dedent )
// } // remote


// ws-service|ws-handler {
module_services_service_wsservice ::= 'ws-service' ( &'.' dot_wsservice_path | wsservice_object ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
dot_wsservice_path ::= '.' wsservice_path {pin=1}
wsservice_object ::= wsservice_object_brace | wsservice_object_colon
private wsservice_object_brace ::= '{' wsservice_entries? '}' { pin=1 }
private wsservice_object_colon ::= ':' indent wsservice_entries? dedent { pin=1 }
wsservice_entries ::= (&'path' wsservice_path | &'port' wsservice_port| &'sessionAware' wsservice_sessionAware| &'interceptors' wsservice_interceptors | &'enabled' wsservice_enabled)*

wsservice_path_id ::= 'path'
wsservice_path ::= wsservice_path_id ('=' | ':') (wsservice_path_block | &'[' wsservice_path_multiple | block_scalar_value | key_value ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
private wsservice_path_block ::= indent wsservice_path_block_item+ dedent { pin=1 }
private wsservice_path_block_item ::= '-' (block_scalar_value | key_value) { pin=1 }

wsservice_port_id ::= 'port'
wsservice_port ::= wsservice_port_id ('=' | ':') (block_scalar_value | key_value) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

wsservice_sessionAware_id ::= 'sessionAware'
wsservice_sessionAware ::= wsservice_sessionAware_id ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

wsservice_enabled_id ::= 'enabled'
wsservice_enabled ::= wsservice_enabled_id ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

wsservice_interceptors_id ::= 'interceptors'
wsservice_interceptors ::= wsservice_interceptors_id ('=' | ':') (wsservice_interceptor_block | &'[' wsservice_interceptor_multiple|wsservice_interceptor_one) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
private wsservice_interceptor_block ::= indent wsservice_interceptor_block_item+ dedent { pin=1 }
private wsservice_interceptor_block_item ::= '-' wsservice_interceptor_one { pin=1 }

private wsservice_path_multiple ::= '[' (block_scalar_value | key_value) (!']' ','? (block_scalar_value | key_value))* ']'

wsservice_interceptor_one ::= reference_modules_value {
    implements="oap.application.plugin.psi.IndentNormal"
}
private wsservice_interceptor_multiple ::= '[' wsservice_interceptor_one ( ','? wsservice_interceptor_one )* ']' {pin=1}


module_services_service_wshandler ::= 'ws-handler' ( &'.' dot_wsservice_path | wshandler_object ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
wshandler_object ::= wshandler_object_brace | wshandler_object_colon
private wshandler_object_brace ::= '{' wshandler_entries? '}' { pin=1 }
private wshandler_object_colon ::= ':' indent wshandler_entries? dedent { pin=1 }
wshandler_entries ::= (&'path' wsservice_path | &'port' wsservice_port| &'compression' wshandler_compression | &'blocking' wshandler_blocking | &'enabled' wsservice_enabled)*
wshandler_compression ::= 'compression' ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
wshandler_blocking ::= 'blocking' ('=' | ':') bool_value {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

// } // ws-service | ws-handler


// configurations = [
module_configurations ::= 'configurations' ( module_configurations_eq | module_configurations_colon ) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePair"
}
private module_configurations_eq ::= '=' '[' module_configuration* ']' { pin=1 }
private module_configurations_colon ::= ':' module_configuration_block+ { pin=1 }
module_configuration ::= '{' module_configuration_entries '}' {
    pin=2
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
module_configuration_block ::= '-' module_configuration_entries {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
module_configuration_entries ::= [] module_configuration_entries_loader module_configuration_entries_config {
    pin=1
}

module_configuration_entries_loader ::= 'loader' ('=' | ':') class_name_psi {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}

module_configuration_entries_config ::= [] 'config' (config_entries_config_eq | &(':' indent '-') config_key_value_array_block | config_object) {
    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
private config_entries_config_eq ::= '=' config_array { pin=1 }

config_array ::= '[' config_array_item? (','? config_array_item)* ']' {
    pin=1
}
config_array_item ::= &'{' config_object | &key_name config_object | block_scalar_value | key_value {
    implements="oap.application.plugin.psi.IndentNormal"
}
config_object ::= config_object_brace | config_object_colon | config_object_bare {
    implements="oap.application.plugin.psi.IndentNormal"
}
private config_object_brace ::= '{' (configuration_key_value_pair)* '}' { pin=1 }
private config_object_colon ::= ':' indent (configuration_key_value_pair)* dedent { pin=1 }
// A bare flat map used as a dash-list item's value (e.g. "- class: X\n  field: Y"), with no
// wrapping '{'/':' of its own - see dashItemStartsKeyValue() in _OapLexer.flex. The first pair
// sits on the same line as the '-' (no indent token precedes it); any further pairs are
// continuation lines wrapped in a single indent/dedent, matching the lexer's actual token
// stream (the indent column is only established once a continuation line is seen at all).
//
// Known limitation: a single-pair item immediately followed by a sibling '-' at the enclosing
// list's own column (e.g. "- class: X\n- class: Y", no second key on either item) is NOT
// supported - the lexer's indent resolver can't yet distinguish "this item's map genuinely has
// more indented content" from "this item has none and the next line is already the next list
// item at the outer column" without a line of lookahead past the dash.
private config_object_bare ::= configuration_key_value_pair (indent (configuration_key_value_pair)+ dedent)? { pin=1 }

configuration_key_value_pair ::=
    ( &'include' module_include )
    | key_name ('.' key_name)*
        (&'=' config_key_value_eq
         | &'{' config_object
         | &(':' indent '-') config_key_value_array_block
         | &(':' indent) config_object
         | config_key_value_colon) {

    pin=1
    implements="oap.application.plugin.psi.OapKeyValuePairWithIndentNormal"
}
private config_key_value_value ::= &'[' config_array | bool_value | block_scalar_value | id_value
private config_key_value_eq ::= '=' config_key_value_value { pin=1 }
private config_key_value_colon ::= ':' config_key_value_value { pin=1 }
private config_key_value_array_block ::= ':' indent config_key_value_array_block_item+ dedent { pin=1 }
private config_key_value_array_block_item ::= '-' config_array_item { pin=1 }

// ] // configurations

// include required("resource")
module_include ::= 'include' 'required' '(' string ')' {
    pin=1
    methods=[getReference]
}
