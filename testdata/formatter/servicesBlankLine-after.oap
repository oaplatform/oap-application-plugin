name = xenoss-reporting-worker

services {
  reporting-configuration {
    implementation = io.xenoss.reporting.logprocessor.configuration.ReportingConfigurationService
    parameters {
      configuration = "change me"
    }
  }

  dictionary-migration {
    implementation = io.xenoss.reporting.DictionaryMigration
    parameters {
      client = <modules.xenoss-reporting-clickhouse.clickhouse-client>
    }
    supervision.supervise = true
  }
}
